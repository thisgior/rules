#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    printf '错误：未找到 Python 3。请先安装 python3。\n' >&2
    exit 1
fi

if ! "$PYTHON_BIN" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
    printf '错误：需要 Python 3.9 或更高版本。\n' >&2
    exit 1
fi

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    if [[ "${ID:-}" == "debian" ]]; then
        debian_major="${VERSION_ID%%.*}"
        if [[ ! "$debian_major" =~ ^(11|12|13)$ ]] && [[ "${RULE_MANAGER_ALLOW_UNSUPPORTED:-0}" != "1" ]]; then
            printf '错误：当前仅支持 Debian 11、12、13；检测到 Debian %s。\n' "${VERSION_ID:-未知}" >&2
            printf '如仅需开发测试，可设置 RULE_MANAGER_ALLOW_UNSUPPORTED=1。\n' >&2
            exit 1
        fi
    else
        printf '警告：当前系统不是 Debian，允许执行只读检查，但不属于正式支持范围。\n' >&2
    fi
fi

export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

run_cli() {
    "$PYTHON_BIN" -m rule_manager.cli "$@"
}

if (( $# > 0 )); then
    exec "$PYTHON_BIN" -m rule_manager.cli "$@"
fi

while true; do
    printf '\nDebian 通用代理规则管理器（只读开发版）\n'
    printf '1. 检查 Clash/Mihomo 配置\n'
    printf '2. 查看运行环境\n'
    printf '0. 退出\n'
    read -r -p '请选择：' choice
    case "$choice" in
        1)
            read -r -p '配置文件路径：' config_path
            run_cli inspect-config "$config_path" || true
            ;;
        2)
            run_cli environment || true
            ;;
        0)
            exit 0
            ;;
        *)
            printf '无效选项，请重新选择。\n' >&2
            ;;
    esac
done
